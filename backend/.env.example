# Razorpay keys (test mode example)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_ReplaceWithYourKeyId
RAZORPAY_KEY_SECRET=ReplaceWithYourKeySecret
PORT=5055

# SMTP for booking receipt emails (Gmail example: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# Online advance amount (INR). Remaining fare is collected offline.
ADVANCE_AMOUNT_INR=1000
